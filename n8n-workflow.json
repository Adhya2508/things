{
  "name": "Customer Segmentation Agent Orchestrator",
  "nodes": [
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "id": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
      "name": "When chat message received"
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are an intelligent Bank Customer Segmentation Assistant. You have access to a FastAPI backend through tools to run customer data analysis, segmentation, explanations, ad-hoc queries, and recommendations.\n\nALWAYS adhere to these rules:\n1. If a session_id is provided by the user, reuse it. If not, generate a descriptive string like 'session_001'.\n2. Segmentation (/agents/segment) MUST run first before explain, query, or customer-specific recommend calls can work.\n3. Present output numbers cleanly formatted with bullet points or tables."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [220, 0],
      "id": "2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [140, 220],
      "id": "3c4d5e6f-7a8b-9c0d-1e2f-3a4b5c6d7e8f",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [300, 220],
      "id": "4d5e6f7a-8b9c-0d1e-2f3a-4b5c6d7e8f9a",
      "name": "Window Buffer Memory"
    },
    {
      "parameters": {
        "name": "run_segmentation",
        "description": "Runs full Data -> Feature -> Segmentation pipeline on a CSV dataset and saves session state. Modes: 'rule' or 'ml'. Must be run before querying or explaining.",
        "method": "POST",
        "url": "http://api:8000/agents/segment",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session_id\": \"{{ $fromAI('session_id') }}\",\n  \"mode\": \"{{ $fromAI('mode', 'rule') }}\",\n  \"csv_path\": \"{{ $fromAI('csv_path', 'CC GENERAL.csv') }}\",\n  \"k\": {{ $fromAI('k', 'null') }}\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [480, -180],
      "id": "5e6f7a8b-9c0d-1e2f-3a4b-5c6d7e8f9a0b",
      "name": "Segment Agent Tool"
    },
    {
      "parameters": {
        "name": "run_eda",
        "description": "Performs Exploratory Data Analysis. Calculates missing values, summary statistics, and correlation matrix.",
        "method": "POST",
        "url": "http://api:8000/agents/eda",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session_id\": \"{{ $fromAI('session_id') }}\",\n  \"csv_path\": \"{{ $fromAI('csv_path', 'CC GENERAL.csv') }}\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [480, -60],
      "id": "6f7a8b9c-0d1e-2f3a-4b5c-6d7e8f9a0b1c",
      "name": "EDA Agent Tool"
    },
    {
      "parameters": {
        "name": "explain_customer",
        "description": "Explains why a specific customer ID was placed into their segment. Uses threshold evaluation for rule-mode or SHAP values for ML-mode.",
        "method": "POST",
        "url": "http://api:8000/agents/explain",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session_id\": \"{{ $fromAI('session_id') }}\",\n  \"customer_id\": \"{{ $fromAI('customer_id') }}\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [480, 60],
      "id": "7a8b9c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d",
      "name": "Explainability Tool"
    },
    {
      "parameters": {
        "name": "run_query",
        "description": "Answers ad-hoc follow-up queries against an existing session. Supported actions: 'compare_segments' or 'near_priority_candidates'.",
        "method": "POST",
        "url": "http://api:8000/agents/query",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session_id\": \"{{ $fromAI('session_id') }}\",\n  \"action\": \"{{ $fromAI('action') }}\",\n  \"params\": {{ $fromAI('params', '{}') }}\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [480, 180],
      "id": "8b9c0d1e-2f3a-4b5c-6d7e-8f9a0b1c2d3e",
      "name": "Query Agent Tool"
    },
    {
      "parameters": {
        "name": "run_recommend",
        "description": "Generates retention ('retain') or cross-sell/upsell ('grow') recommendations for a segment or customized for a customer_id.",
        "method": "POST",
        "url": "http://api:8000/agents/recommend",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session_id\": \"{{ $fromAI('session_id') }}\",\n  \"segment\": \"{{ $fromAI('segment') }}\",\n  \"intent\": \"{{ $fromAI('intent', 'grow') }}\",\n  \"customer_id\": \"{{ $fromAI('customer_id', '') }}\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [480, 300],
      "id": "9c0d1e2f-3a4b-5c6d-7e8f-9a0b1c2d3e4f",
      "name": "Recommendation Tool"
    },
    {
      "parameters": {
        "name": "get_session_info",
        "description": "Retrieves session metadata, including segment counts, metrics, timestamp, and mode used.",
        "method": "GET",
        "url": "=http://api:8000/agents/session/{{ $fromAI('session_id') }}"
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [480, 420],
      "id": "0d1e2f3a-4b5c-6d7e-8f9a-0b1c2d3e4f5a",
      "name": "Session Info Tool"
    }
  ],
